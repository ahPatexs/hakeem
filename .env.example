DATABASE_URL="postgresql://hakeem:hakeem@localhost:5433/hakeem?schema=public"
DIRECT_URL="postgresql://hakeem:hakeem@localhost:5433/hakeem?schema=public"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_SECRET="replace-with-a-random-secret-at-least-32-chars"
AUTH_URL="http://localhost:3000"
REVALIDATE_SECRET="change-me-to-a-random-32-char-secret"
CONTACT_NOTIFY_EMAIL="ops@hakeem.example"
RESEND_API_KEY=""
EMAIL_FROM="Hakeem <noreply@hakeem.example>"
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
CONTENT_PROVIDER="static"

# Patient portal adapters (optional — stubs used when unset)
BLOB_STORAGE_DIR=".data/uploads"
PAYMENT_PROVIDER="stub"
TELEMEDICINE_PROVIDER="stub"
TELEMEDICINE_ADAPTER="stub"
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
VIDEO_WEBHOOK_SECRET=
AI_ASSISTANT_PROVIDER="stub"

# AI Healthcare Platform (Module 7)
# AI_ASSISTANT_PROVIDER: "stub" | "gemini" (Google AI Studio free tier) | "openai"
# Prefer gemini for demos: create a free key at https://aistudio.google.com/apikey
# GEMINI_API_KEY required when provider is "gemini"; OPENAI_API_KEY when "openai"
# Production also requires PLATFORM_AI_BAA_SATISFIED=true for non-stub providers
GEMINI_API_KEY=
GEMINI_AI_MODEL="gemini-2.5-flash"
OPENAI_API_KEY=
AI_EMBEDDINGS_PROVIDER="stub"
# AI_STUB_MODE: "ok" (default) or "fail" — force provider failures for degradation testing
AI_STUB_MODE="ok"

# Admin portal (Module 4)
ADMIN_EXPORT_ROW_CAP=10000
ADMIN_ANALYTICS_EXPORT_ROW_CAP=10000
ADMIN_HEALTH_PING_ENABLED=true
ADMIN_NOTIFICATION_POLL_MS=30000

# Platform Services (Module 5)
CRON_SECRET="change-me-cron-secret"
PLATFORM_PUSH_ENABLED=false
PLATFORM_AI_BAA_SATISFIED=false
PLATFORM_VIDEO_RECORDING_ENABLED=false
PAYMENTS_HEALTH_URL=
AI_HEALTH_URL=
TELEMEDICINE_HEALTH_URL=
EMAIL_HEALTH_URL=

# Local Postgres: docker compose up -d
# Then: npx prisma migrate deploy && npm run prisma:seed
