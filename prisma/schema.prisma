generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Gender {
  MALE
  FEMALE
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  SPAM
}

enum SubscriptionState {
  PENDING
  CONFIRMED
  UNSUBSCRIBED
}

enum LocaleCode {
  EN
  AR
}

model Specialty {
  id        String   @id @default(cuid())
  slug      String   @unique
  nameEn    String
  nameAr    String
  sortOrder Int      @default(0)
  doctors   Doctor[]
}

model Doctor {
  id               String        @id @default(cuid())
  slug             String        @unique
  status           PublishStatus @default(DRAFT)
  nameEn           String
  nameAr           String
  titleEn          String?
  titleAr          String?
  bioEn            String?
  bioAr            String?
  photoUrl         String?
  photoAltEn       String?
  photoAltAr       String?
  gender           Gender?
  languages        String[]
  yearsExperience  Int?
  credentialsEn    String[]
  credentialsAr    String[]
  isAvailable      Boolean       @default(true)
  metaDescEn       String?
  metaDescAr       String?
  specialtyId      String
  specialty        Specialty     @relation(fields: [specialtyId], references: [id])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  publishedAt      DateTime?
  appointments     Appointment[]
  medicalRecords   MedicalRecord[]
  prescriptions    Prescription[]

  @@index([status, specialtyId])
  @@index([status, isAvailable])
}

model Author {
  id        String     @id @default(cuid())
  nameEn    String
  nameAr    String
  roleEn    String?
  roleAr    String?
  avatarUrl String?
  posts     BlogPost[]
}

model Category {
  id        String     @id @default(cuid())
  slug      String     @unique
  nameEn    String
  nameAr    String
  sortOrder Int        @default(0)
  posts     BlogPost[] @relation("PostCategories")
}

model Tag {
  id        String     @id @default(cuid())
  slug      String     @unique
  nameEn    String
  nameAr    String
  sortOrder Int        @default(0)
  posts     BlogPost[] @relation("PostTags")
}

model BlogPost {
  id            String        @id @default(cuid())
  slug          String        @unique
  status        PublishStatus @default(DRAFT)
  titleEn       String
  titleAr       String
  summaryEn     String
  summaryAr     String
  bodyEn        Json
  bodyAr        Json
  bodyPlainEn   String?
  bodyPlainAr   String?
  coverUrl      String?
  coverAltEn    String?
  coverAltAr    String?
  authorId      String
  author        Author        @relation(fields: [authorId], references: [id])
  categories    Category[]    @relation("PostCategories")
  tags          Tag[]         @relation("PostTags")
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, publishedAt])
}

model Service {
  id             String        @id @default(cuid())
  slug           String        @unique
  status         PublishStatus @default(PUBLISHED)
  nameEn         String
  nameAr         String
  descriptionEn  String
  descriptionAr  String
  iconKey        String
  sortOrder      Int           @default(0)
}

model Testimonial {
  id           String        @id @default(cuid())
  status       PublishStatus @default(DRAFT)
  authorNameEn String
  authorNameAr String
  contextEn    String?
  contextAr    String?
  quoteEn      String
  quoteAr      String
  rating       Int?
  sortOrder    Int           @default(0)
}

model FaqItem {
  id          String        @id @default(cuid())
  status      PublishStatus @default(PUBLISHED)
  sortOrder   Int           @default(0)
  questionEn  String
  questionAr  String
  answerEn    String
  answerAr    String
  categoryEn  String?
  categoryAr  String?
}

model PricingPlan {
  id              String        @id @default(cuid())
  status          PublishStatus @default(DRAFT)
  nameEn          String
  nameAr          String
  descriptionEn   String
  descriptionAr   String
  priceLabelEn    String
  priceLabelAr    String
  featuresEn      String[]
  featuresAr      String[]
  isHighlighted   Boolean       @default(false)
  sortOrder       Int           @default(0)
}

model LegalDocument {
  id            String   @id @default(cuid())
  kind          String   @unique
  titleEn       String
  titleAr       String
  bodyEn        Json
  bodyAr        Json
  effectiveDate DateTime
  updatedAt     DateTime @updatedAt
}

model ContactInquiry {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  topic     String
  message   String
  locale    LocaleCode
  status    InquiryStatus @default(NEW)
  ipHash    String?
  createdAt DateTime      @default(now())
}

model NewsletterSubscription {
  id              String            @id @default(cuid())
  email           String            @unique
  state           SubscriptionState @default(PENDING)
  locale          LocaleCode
  confirmedAt     DateTime?
  unsubscribedAt  DateTime?
  providerId      String?
  createdAt       DateTime          @default(now())
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ─── Auth & RBAC (002-auth-rbac) ─────────────────────────────────────────────

enum UserRole {
  PATIENT
  DOCTOR
  ADMIN
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum DoctorApprovalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum AuthChallengeKind {
  EMAIL_VERIFY
  PASSWORD_RESET
  INVITE_SET_PASSWORD
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED
}

model User {
  id                     String                @id @default(cuid())
  name                   String?
  email                  String                @unique
  emailVerified          DateTime?
  image                  String?
  passwordHash           String?
  role                   UserRole              @default(PATIENT)
  status                 AccountStatus         @default(PENDING_VERIFICATION)
  doctorApproval         DoctorApprovalStatus?
  doctorRejectionReason  String?
  failedLoginCount       Int                   @default(0)
  lockedUntil            DateTime?
  mustChangePassword     Boolean               @default(false)
  localePreference       LocaleCode?
  doctorProfileId        String?
  createdByAdminId       String?
  aiDisabledAt           DateTime?
  aiDisabledReason         String?
  aiDisabledByUserId       String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  accounts           Account[]
  sessions           Session[]
  refreshCredentials RefreshCredential[]
  challenges         AuthChallenge[]
  passwordHistories  PasswordHistory[]
  mfaFactors         MfaFactor[]
  auditEventsActor   SecurityAuditEvent[] @relation("AuditActor")
  auditEventsTarget  SecurityAuditEvent[] @relation("AuditTarget")
  patientProfile     PatientProfile?
  medicalProfile     MedicalProfile?
  portalSettings     PortalSettings?
  patientUploads     PatientUpload[]
  appointments       Appointment[]        @relation("PatientAppointments")
  clinicalDocuments  ClinicalDocument[]
  medicalRecords     MedicalRecord[]
  labResults         LabResult[]
  prescriptions      Prescription[]
  paymentObligations PaymentObligation[]
  notifications      Notification[]
  aiConversations    AiConversation[]
  soapNotesAsPatient SoapNote[]           @relation("SoapPatient")
  summariesAsPatient ClinicalSummary[]    @relation("SummaryPatient")
  labReviewAcks      LabReviewAcknowledgement[]
  doctorAiConversations DoctorAiConversation[]
  panelAsPatient     DoctorPatientPanel[] @relation("PanelPatient")
  doctorProfileExtras DoctorProfileExtras?
  pushDevices        PushDeviceRegistration[]
  allergyEntries     AllergyEntry[]
  conditionEntries   ConditionEntry[]
  immunizationEntries ImmunizationEntry[]
  familyHistoryEntries FamilyHistoryEntry[]
  lifestyleProfile   LifestyleProfile?
  emergencyInfo      EmergencyInfo?
  diagnoses          Diagnosis[]
  carePlans          CarePlan[]
  consentEvents      ConsentEvent[]
  emrTimelineEvents  EmrTimelineEvent[]
  doctorNotesAsPatient DoctorNote[] @relation("DoctorNotePatient")
  aiSymptomSessions  AiSymptomSession[]
  aiRecommendations  AiRecommendation[]
  aiDraftsAsDoctor   AiDraftArtifact[] @relation("AiDraftDoctor")
  aiDraftsAsPatient  AiDraftArtifact[] @relation("AiDraftPatient")
  aiFeedback         AiFeedback[]

  @@index([role, status])
  @@index([doctorApproval])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id             String   @id @default(cuid())
  sessionToken   String   @unique
  userId         String
  expires        DateTime
  lastActiveAt   DateTime @default(now())
  idleExpiresAt  DateTime
  userAgent      String?
  ipHash         String?
  rememberMe     Boolean  @default(false)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lastActiveAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AuthChallenge {
  id         String            @id @default(cuid())
  userId     String?
  email      String
  kind       AuthChallengeKind
  tokenHash  String            @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime          @default(now())
  user       User?             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, kind, createdAt])
}

model RefreshCredential {
  id             String    @id @default(cuid())
  userId         String
  tokenHash      String    @unique
  familyId       String
  expiresAt      DateTime
  rotatedFromId  String?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
}

model PasswordHistory {
  id           String   @id @default(cuid())
  userId       String
  passwordHash String
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model SecurityAuditEvent {
  id           String       @id @default(cuid())
  type         String
  actorUserId  String?
  targetUserId String?
  outcome      AuditOutcome
  ipHash       String?
  userAgent    String?
  meta         Json?
  createdAt    DateTime     @default(now())
  actor        User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  target       User?        @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([type, createdAt])
}

model MfaFactor {
  id               String    @id @default(cuid())
  userId           String
  type             String    @default("TOTP")
  secretEncrypted  String?
  enabledAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum AppointmentStatus {
  HELD
  CONFIRMED
  CHECKED_IN
  CANCELLED
  COMPLETED
  NO_SHOW
  IN_PROGRESS
  RESCHEDULED
}

enum AppointmentMode {
  IN_PERSON
  VIDEO
}

enum LabReleaseStatus {
  PENDING_REVIEW
  RELEASED
  RETRACTED
  SUPERSEDED
}

enum LabResultPhase {
  PRELIMINARY
  FINAL
}

enum PrescriptionStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
}

enum ClinicalNoteStatus {
  DRAFT
  FINAL
  DISMISSED
}

enum DoctorAiMode {
  MEDICAL
  DOCUMENTATION
  PRESCRIPTION
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  DISPUTED
}

enum NotificationCategory {
  APPOINTMENT
  QUEUE
  CLINICAL
  DOCUMENTATION
  RESULTS
  PRESCRIPTION
  PAYMENT
  SYSTEM
  SECURITY
  HEALTH
  AI_GOVERNANCE
  ADMIN_OPS
}

enum HealthOverallStatus {
  HEALTHY
  DEGRADED
  DOWN
}

enum HealthComponentKey {
  APP
  DATABASE
  PAYMENTS
  AI
  TELEMEDICINE
  EMAIL
  SMS
  STORAGE
}

enum AnnouncementSegment {
  PATIENT
  DOCTOR
  ALL
}

enum PlatformSettingValueType {
  BOOLEAN
  STRING
  JSON
}

enum UploadScanStatus {
  PENDING
  CLEAN
  REJECTED
}

enum ClinicalDocumentKind {
  RECORD_ATTACHMENT
  LAB_ATTACHMENT
  PATIENT_UPLOAD
  RECEIPT
  REFERRAL
  CERTIFICATE
  CONSENT_EVIDENCE
  IMAGING_REPORT
  OTHER
}

enum EmrAttestationSource {
  PATIENT_REPORTED
  CLINICIAN_ATTESTED
}

enum EmrSeverity {
  MILD
  MODERATE
  SEVERE
  CRITICAL
}

enum EmrConditionStatus {
  ACTIVE
  RESOLVED
  INACTIVE
}

enum EmrPlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum EmrConsentEventKind {
  ACKNOWLEDGE
  WITHDRAW
}

enum EmrTimelineEventType {
  ENCOUNTER
  APPOINTMENT
  PRESCRIPTION
  LAB
  IMAGING
  DOCUMENT
  CONSENT
  DIAGNOSIS
  PLAN
  NOTE
  SYSTEM
}

enum EmrTimelineVisibility {
  PATIENT
  CLINICIAN
  ADMIN
  ALL_AUTHORIZED
}

enum EmrTimelineEventStatus {
  ACTIVE
  SUPERSEDED
  HIDDEN
}

model PatientProfile {
  userId               String   @id
  phone                String?
  dateOfBirth          DateTime?
  sexAtBirth           String?
  addressLine1         String?
  city                 String?
  region               String?
  emergencyContactName String?
  emergencyContactPhone String?
  insuranceProvider    String?
  insurancePolicyNumber String?
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MedicalProfile {
  userId             String   @id
  bloodType          String?
  allergies          String[] @default([])
  conditions         String[] @default([])
  currentMedications String[] @default([])
  notes              String?
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PortalSettings {
  userId                   String     @id
  locale                   LocaleCode @default(AR)
  theme                    String     @default("system")
  notifyAppointmentEmail   Boolean    @default(true)
  notifyClinicalEmail      Boolean    @default(true)
  notifyPrescriptionEmail  Boolean    @default(true)
  notifyPaymentEmail       Boolean    @default(true)
  notifySystemEmail        Boolean    @default(true)
  user                     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PatientUpload {
  id           String           @id @default(cuid())
  patientUserId String
  fileName     String
  contentType  String
  sizeBytes    Int
  storageKey   String
  scanStatus   UploadScanStatus @default(PENDING)
  purpose      String           @default("other")
  createdAt    DateTime         @default(now())
  patient      User             @relation(fields: [patientUserId], references: [id], onDelete: Cascade)

  @@index([patientUserId, createdAt])
}

model Appointment {
  id                String            @id @default(cuid())
  patientUserId     String
  doctorId          String
  mode              AppointmentMode
  status            AppointmentStatus @default(HELD)
  startAt           DateTime
  endAt             DateTime
  holdExpiresAt     DateTime?
  locationText      String?
  reason            String?
  cancellationReason String?
  rescheduledFromId String?
  videoRoomId       String?
  checkedInAt       DateTime?
  completedAt       DateTime?
  noShowAt          DateTime?
  noShowReason      String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  patient           User              @relation("PatientAppointments", fields: [patientUserId], references: [id], onDelete: Cascade)
  doctor            Doctor            @relation(fields: [doctorId], references: [id])
  paymentObligations PaymentObligation[]
  soapNotes         SoapNote[]
  clinicalSummaries ClinicalSummary[]
  prescriptions     Prescription[]    @relation("AppointmentPrescriptions")
  videoSession      VideoSession?
  aiSymptomSessions AiSymptomSession[]
  aiDrafts          AiDraftArtifact[]

  @@index([patientUserId, startAt])
  @@index([doctorId, startAt])
  @@index([doctorId, status])
  @@index([doctorId, checkedInAt])
  @@index([status, holdExpiresAt])
}

model ClinicalDocument {
  id            String               @id @default(cuid())
  patientUserId String
  kind          ClinicalDocumentKind
  title         String
  contentType   String
  storageKey    String
  byteSize      Int
  classification String?
  deletedAt     DateTime?
  deletedByUserId String?
  legalHold     Boolean              @default(false)
  createdAt     DateTime             @default(now())
  patient       User                 @relation(fields: [patientUserId], references: [id], onDelete: Cascade)
  medicalRecords MedicalRecord[]
  labResults    LabResult[]
  prescriptions Prescription[]
  paymentReceipts PaymentObligation[]

  @@index([patientUserId, createdAt])
  @@index([patientUserId, deletedAt])
}

model MedicalRecord {
  id            String            @id @default(cuid())
  patientUserId String
  title         String
  recordType    String
  summary       String?
  recordedAt    DateTime
  doctorId      String?
  documentId    String?
  createdAt     DateTime          @default(now())
  patient       User              @relation(fields: [patientUserId], references: [id], onDelete: Cascade)
  doctor        Doctor?           @relation(fields: [doctorId], references: [id])
  document      ClinicalDocument? @relation(fields: [documentId], references: [id])

  @@index([patientUserId, recordedAt])
}

model LabResult {
  id             String           @id @default(cuid())
  patientUserId  String
  title          String
  panelCode      String?
  releaseStatus  LabReleaseStatus @default(PENDING_REVIEW)
  phase          LabResultPhase   @default(FINAL)
  criticalFlag   Boolean          @default(false)
  resultedAt     DateTime
  summary        String?
  documentId     String?
  supersededById String?
  patient        User             @relation(fields: [patientUserId], references: [id], onDelete: Cascade)
  document       ClinicalDocument? @relation(fields: [documentId], references: [id])
  reviewAcks     LabReviewAcknowledgement[]

  @@index([patientUserId, resultedAt])
  @@index([patientUserId, releaseStatus])
}

model Prescription {
  id             String             @id @default(cuid())
  patientUserId  String
  medicationName String
  instructions   String
  status         PrescriptionStatus @default(ACTIVE)
  prescribedAt   DateTime
  startsAt       DateTime?
  endsAt         DateTime?
  doctorId       String?
  documentId     String?
  appointmentId  String?
  signedAt       DateTime?
  signerUserId   String?
  contentVersion Int                @default(1)
  renewedFromId  String?
  deletedAt      DateTime?
  allergyAckAt   DateTime?
  interactionAckAt DateTime?
  aiAssisted     Boolean            @default(false)
  patient        User               @relation(fields: [patientUserId], references: [id], onDelete: Cascade)
  doctor         Doctor?            @relation(fields: [doctorId], references: [id])
  document       ClinicalDocument?  @relation(fields: [documentId], references: [id])
  appointment    Appointment?       @relation("AppointmentPrescriptions", fields: [appointmentId], references: [id])
  lines          PrescriptionLine[]
  renewedFrom    Prescription?      @relation("PrescriptionRenewals", fields: [renewedFromId], references: [id])
  renewals       Prescription[]     @relation("PrescriptionRenewals")

  @@index([patientUserId, status])
  @@index([patientUserId, prescribedAt])
  @@index([doctorId, status])
  @@index([appointmentId])
  @@index([renewedFromId])
}

model PrescriptionLine {
  id             String       @id @default(cuid())
  prescriptionId String
  medicationName String
  dose           String?
  route          String?
  frequency      String?
  duration       String?
  quantity       String?
  instructions   String?
  sortOrder      Int          @default(0)
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId, sortOrder])
}

model PaymentObligation {
  id                 String        @id @default(cuid())
  patientUserId      String
  appointmentId      String?
  description        String
  amountCents        Int
  currency           String        @default("SAR")
  status             PaymentStatus @default(PENDING)
  providerRef        String?
  idempotencyKey     String        @unique
  receiptDocumentId  String?
  refundedAmountCents Int          @default(0)
  refundReason       String?
  refundedAt         DateTime?
  refundedByUserId   String?
  disputeNote        String?
  disputedAt         DateTime?
  disputedByUserId   String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  patient            User          @relation(fields: [patientUserId], references: [id], onDelete: Cascade)
  appointment        Appointment?  @relation(fields: [appointmentId], references: [id])
  receiptDocument    ClinicalDocument? @relation(fields: [receiptDocumentId], references: [id])
  attempts           PaymentAttempt[]

  @@index([patientUserId, createdAt])
  @@index([patientUserId, status])
  @@index([status, createdAt])
}

model PaymentAttempt {
  id               String        @id @default(cuid())
  obligationId     String
  providerIntentId String
  status           PaymentStatus @default(PENDING)
  rawEventId       String?
  createdAt        DateTime      @default(now())
  obligation       PaymentObligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)

  @@index([obligationId, createdAt])
}

model Notification {
  id              String               @id @default(cuid())
  recipientUserId String
  category        NotificationCategory
  title           String
  body            String
  href            String?
  readAt          DateTime?
  dismissedAt     DateTime?
  createdAt       DateTime             @default(now())
  recipient       User                 @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, createdAt])
  @@index([recipientUserId, readAt])
}

model AiConversation {
  id             String               @id @default(cuid())
  patientUserId  String
  locale         LocaleCode           @default(AR)
  feature        AiFeatureKey         @default(PATIENT_ASSISTANT)
  title          String?
  status         AiConversationStatus @default(ACTIVE)
  rollingSummary String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  patient        User                 @relation(fields: [patientUserId], references: [id], onDelete: Cascade)
  messages       AiMessage[]

  @@index([patientUserId, updatedAt])
  @@index([patientUserId, status, updatedAt])
}

model AiMessage {
  id              String        @id @default(cuid())
  conversationId  String
  role            AiMessageRole
  content         String
  redFlagged      Boolean       @default(false)
  disclaimerShown Boolean       @default(false)
  /** FR-024 explainability: chartCategories, kbSources (titles), mode */
  evidence        Json?
  promptVersionId String?
  modelConfigId   String?
  createdAt       DateTime      @default(now())
  conversation    AiConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  promptVersion   AiPromptVersion? @relation(fields: [promptVersionId], references: [id])
  modelConfig     AiModelConfig?   @relation(fields: [modelConfigId], references: [id])
  feedback        AiFeedback[]

  @@index([conversationId, createdAt])
}

// ── Doctor Portal (Module 3) ──────────────────────────────────────────────

model SoapNote {
  id              String             @id @default(cuid())
  appointmentId   String
  patientUserId   String
  doctorId        String
  authorUserId    String
  status          ClinicalNoteStatus @default(DRAFT)
  version         Int                @default(1)
  parentNoteId    String?
  subjective      String             @default("")
  objective       String             @default("")
  assessment      String             @default("")
  plan            String             @default("")
  contentHash     String?
  signedAt        DateTime?
  signerUserId    String?
  amendmentReason String?
  lateAmendment   Boolean            @default(false)
  dismissedAt     DateTime?
  dismissReason   String?
  aiAssisted      Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  appointment     Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient         User               @relation("SoapPatient", fields: [patientUserId], references: [id], onDelete: Cascade)

  @@index([appointmentId, version])
  @@index([doctorId, status])
  @@index([patientUserId, createdAt])
}

model ClinicalSummary {
  id              String             @id @default(cuid())
  appointmentId   String
  patientUserId   String
  doctorId        String
  authorUserId    String
  status          ClinicalNoteStatus @default(DRAFT)
  version         Int                @default(1)
  parentSummaryId String?
  body            String             @default("")
  contentHash     String?
  signedAt        DateTime?
  signerUserId    String?
  amendmentReason String?
  lateAmendment   Boolean            @default(false)
  dismissedAt     DateTime?
  dismissReason   String?
  aiAssisted      Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  appointment     Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient         User               @relation("SummaryPatient", fields: [patientUserId], references: [id], onDelete: Cascade)

  @@index([appointmentId, version])
  @@index([doctorId, status])
}

model LabReviewAcknowledgement {
  id           String    @id @default(cuid())
  labResultId  String
  doctorUserId String
  reviewedAt   DateTime  @default(now())
  labResult    LabResult @relation(fields: [labResultId], references: [id], onDelete: Cascade)
  doctor       User      @relation(fields: [doctorUserId], references: [id], onDelete: Cascade)

  @@unique([labResultId, doctorUserId])
}

model DoctorAiConversation {
  id            String            @id @default(cuid())
  doctorUserId  String
