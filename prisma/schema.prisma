// ── Platform Services (Module 5) ──────────────────────────────────────────

enum BackgroundJobState {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum OutboundChannel {
  EMAIL
  SMS
  PUSH
}

enum OutboundMessageStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

enum PushDevicePlatform {
  WEB
  IOS
  ANDROID
}

model BackgroundJob {
  id             String             @id @default(cuid())
  type           String
  idempotencyKey String
  payload        Json
  state          BackgroundJobState @default(QUEUED)
  attempts       Int                @default(0)
  maxAttempts    Int                @default(5)
  runAfter       DateTime           @default(now())
  lastError      String?
  lockedAt       DateTime?
  lockedBy       String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([type, idempotencyKey])
  @@index([state, runAfter])
}

model WebhookReceipt {
  id              String    @id @default(cuid())
  provider        String
  providerEventId String
  eventType       String
  signatureValid  Boolean
  freshnessValid  Boolean?
  processedAt     DateTime?
  obligationId    String?
  rawHash         String
  createdAt       DateTime  @default(now())

  @@unique([provider, providerEventId])
  @@index([createdAt])
}

model OutboundMessage {
  id                    String                @id @default(cuid())
  channel               OutboundChannel
  purpose               String
  recipientUserId       String?
  toAddress             String
  locale                LocaleCode            @default(AR)
  templateKey           String?
  status                OutboundMessageStatus @default(QUEUED)
  idempotencyKey        String                @unique
  providerMessageId     String?
  relatedNotificationId String?
  createdAt             DateTime              @default(now())
  sentAt                DateTime?

  @@index([recipientUserId, createdAt])
  @@index([status, createdAt])
}

model SearchDoctorProjection {
  doctorId     String   @id
  nameEn       String
  nameAr       String
  specialtyKeys String[] @default([])
  city         String?
  isBookable   Boolean  @default(false)
  isPublished  Boolean  @default(false)
  searchText   String
  indexedAt    DateTime @default(now())

  @@index([isBookable, isPublished])
}

model PushDeviceRegistration {
  id         String             @id @default(cuid())
  userId     String
  tokenHash  String
  platform   PushDevicePlatform @default(WEB)
  lastSeenAt DateTime           @default(now())
  revokedAt  DateTime?
  createdAt  DateTime           @default(now())
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tokenHash])
  @@index([userId, revokedAt])
}

enum VideoSessionState {
  SCHEDULED
  WAITING
  IN_CALL
  ENDED
  CANCELLED
}

model VideoSession {
  id               String            @id @default(cuid())
  appointmentId    String            @unique
  provider         String            @default("stub")
  roomId           String
  roomName         String
  state            VideoSessionState @default(SCHEDULED)
  recordingEnabled Boolean           @default(false)
  startedAt        DateTime?
  endedAt          DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  appointment      Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  events           VideoCallEvent[]

  @@index([state, createdAt])
  @@index([provider, createdAt])
}

model VideoCallEvent {
  id          String   @id @default(cuid())
  sessionId   String
  actorUserId String?
  kind        String
  metadata    Json?
  createdAt   DateTime @default(now())
  session     VideoSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([kind, createdAt])
}

