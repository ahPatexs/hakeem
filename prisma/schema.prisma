model EmergencyInfo {
  patientUserId         String   @id
  contactName           String?
  contactPhone          String?
  criticalAlertsText    String?
  clinicianCriticalFlag Boolean  @default(false)
  updatedAt             DateTime @updatedAt
  patient               User     @relation(fields: [patientUserId], references: [id], onDelete: Cascade)
}

model Diagnosis {
  id               String    @id @default(cuid())
  patientUserId    String
  appointmentId    String?
  display          String
  icd10Code        String?
  status           String    @default("ACTIVE")
  recordedByUserId String
  recordedAt       DateTime  @default(now())
  deletedAt        DateTime?
  deletedByUserId  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  patient          User      @relation(fields: [patientUserId], references: [id], onDelete: Cascade)

