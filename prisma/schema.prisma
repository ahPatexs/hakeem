model CarePlan {
  id               String        @id @default(cuid())
  patientUserId    String
  title            String
  kind             String        @default("CARE")
  status           EmrPlanStatus @default(DRAFT)
  goals            Json?
  interventions    Json?
  version          Int           @default(1)
  parentPlanId     String?
  signedAt         DateTime?
  signerUserId     String?
  recordedByUserId String
  deletedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  patient          User          @relation(fields: [patientUserId], references: [id], onDelete: Cascade)

  @@index([patientUserId, status])
}

model ConsentType {
  id        String               @id @default(cuid())
  code      String               @unique
  nameEn    String
  nameAr    String
  versions  ConsentTextVersion[]
}

model ConsentTextVersion {
  id          String         @id @default(cuid())
  typeId      String
  version     Int
  locale      LocaleCode     @default(AR)
  body        String
  bodyHash    String
  effectiveAt DateTime       @default(now())
  type        ConsentType    @relation(fields: [typeId], references: [id], onDelete: Cascade)
  events      ConsentEvent[]

  @@unique([typeId, version, locale])
}

model ConsentEvent {
  id              String             @id @default(cuid())
  patientUserId   String
  textVersionId   String
  kind            EmrConsentEventKind
  actorUserId     String
  at              DateTime           @default(now())
  evidenceDocumentId String?
  patient         User               @relation(fields: [patientUserId], references: [id], onDelete: Cascade)
  textVersion     ConsentTextVersion @relation(fields: [textVersionId], references: [id])

  @@index([patientUserId, at])
  @@index([textVersionId])
}

model EmrTimelineEvent {
  id            String                 @id @default(cuid())
  patientUserId String
  type          EmrTimelineEventType
  effectiveAt   DateTime
  actorUserId   String?
  refType       String
  refId         String
  visibility    EmrTimelineVisibility  @default(ALL_AUTHORIZED)
  status        EmrTimelineEventStatus @default(ACTIVE)
  title         String
  summary       String?
  createdAt     DateTime               @default(now())
  patient       User                   @relation(fields: [patientUserId], references: [id], onDelete: Cascade)

  @@unique([refType, refId, type])
  @@index([patientUserId, effectiveAt])
  @@index([patientUserId, type, status])
}

// ── AI Healthcare Platform (Module 7) ────────────────────────────────────

enum AiFeatureKey {
  PATIENT_ASSISTANT
  SYMPTOM_CHECKER
  RECOMMENDATIONS
  DOCTOR_SOAP
  DOCTOR_SUMMARY
  RX_ASSIST
  CDS
}

enum AiConversationStatus {
  ACTIVE
  HIDDEN
}

enum AiMessageRole {
  USER
  ASSISTANT
  SYSTEM_NOTICE
}

enum AiSymptomOutcome {
  SELF_CARE
  SEE_DOCTOR
  URGENT
  EMERGENCY
}

enum AiSymptomSessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum AiDraftKind {
  SOAP
  CONSULT_SUMMARY
  RX_SUGGESTION
}

enum AiDraftStatus {
  PENDING
  ACCEPTED
  DISCARDED
}

enum AiPromptStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AiProviderKind {
  OPENAI
  STUB
}

enum AiUsageOutcome {
  SUCCESS
  ERROR
  REFUSED
  RED_FLAG
  BUDGET_BLOCKED
  RATE_LIMITED
}

enum AiGuardrailTrigger {
  RED_FLAG
  INJECTION
  OUTPUT_POLICY
  CONSENT_BLOCK
}

enum AiBudgetScope {
  GLOBAL
  FEATURE
}

enum AiFeedbackRating {
  HELPFUL
  NOT_HELPFUL
  FLAGGED
}

enum AiRecommendationStatus {
  ACTIVE
  DISMISSED
}

model AiSymptomSession {
  id            String                 @id @default(cuid())
  patientUserId String
  locale        LocaleCode             @default(EN)
  status        AiSymptomSessionStatus @default(IN_PROGRESS)
  steps         Json                   @default("[]")
  outcome       AiSymptomOutcome?
  rationale     String?
  redFlagged    Boolean                @default(false)
  appointmentId String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  patient     User         @relation(fields: [patientUserId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([patientUserId, createdAt])
}

model AiRecommendation {
  id            String                 @id @default(cuid())
  patientUserId String
  locale        LocaleCode             @default(EN)
  title         String
  body          String
  reason        String
  sourceKinds   String[]               @default([])
  status        AiRecommendationStatus @default(ACTIVE)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  patient User @relation(fields: [patientUserId], references: [id], onDelete: Cascade)

  @@index([patientUserId, status])
}

model AiDraftArtifact {
  id              String        @id @default(cuid())
  kind            AiDraftKind
  doctorUserId    String
  patientUserId   String
  appointmentId   String?
  content         Json
  evidence        Json          @default("{}")
  conflicts       Json?
  status          AiDraftStatus @default(PENDING)
  acceptedIntoId  String?
  promptVersionId String?
  modelConfigId   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  doctor      User         @relation("AiDraftDoctor", fields: [doctorUserId], references: [id])
  patient     User         @relation("AiDraftPatient", fields: [patientUserId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([doctorUserId, status, createdAt])
  @@index([patientUserId, kind])
}

model AiPromptTemplate {
  id        String       @id @default(cuid())
  feature   AiFeatureKey @unique
  name      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  versions AiPromptVersion[]
}

model AiPromptVersion {
  id          String         @id @default(cuid())
  templateId  String
  version     Int
  bodyEn      String
  bodyAr      String
  status      AiPromptStatus @default(DRAFT)
  publishedAt DateTime?
  publishedBy String?
  changeNote  String?
  createdAt   DateTime       @default(now())

  template AiPromptTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@unique([templateId, version])
  @@index([templateId, status])
}

model AiModelConfig {
  id              String         @id @default(cuid())
  feature         AiFeatureKey
  provider        AiProviderKind @default(STUB)
  modelName       String
  fallbackModel   String?
  temperature     Float          @default(0.3)
  maxOutputTokens Int            @default(1024)
  active          Boolean        @default(true)
  version         Int            @default(1)
  updatedBy       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  messages AiMessage[]

  @@index([feature, active])
}

model AiUsageEvent {
  id               String         @id @default(cuid())
  feature          AiFeatureKey
  role             String
  locale           LocaleCode     @default(EN)
  userId           String?
  modelConfigId    String?
  promptVersionId  String?
  promptTokens     Int            @default(0)
  completionTokens Int            @default(0)
  latencyMs        Int            @default(0)
  outcome          AiUsageOutcome
  estimatedCostUsd Decimal        @default(0) @db.Decimal(12, 6)
  createdAt        DateTime       @default(now())

  @@index([createdAt, feature])
  @@index([feature, outcome, createdAt])
}

model AiCostBudget {
  id             String        @id @default(cuid())
  scope          AiBudgetScope @default(GLOBAL)
  feature        AiFeatureKey?
  monthlyUsd     Decimal       @db.Decimal(12, 2)
  alertThreshold Int           @default(80)
  hardCap        Boolean       @default(false)
  breachedAt     DateTime?
  updatedBy      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([scope, feature])
}

model AiGuardrailEvent {
  id        String             @id @default(cuid())
  trigger   AiGuardrailTrigger
  feature   AiFeatureKey
  role      String
  category  String?
  createdAt DateTime           @default(now())

  @@index([createdAt, trigger])
}

model AiFeedback {
  id        String           @id @default(cuid())
  messageId String
  userId    String
  rating    AiFeedbackRating
  category  String?
  createdAt DateTime         @default(now())

  message AiMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

model AiKnowledgeDoc {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  locale      LocaleCode @default(EN)
  kind        String
  status      String     @default("PUBLISHED")
  content     String
  contentHash String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  chunks AiKnowledgeChunk[]
}

model AiKnowledgeChunk {
  id             String                       @id @default(cuid())
  docId          String
  ordinal        Int
  content        String
  locale         LocaleCode                   @default(EN)
  embeddingModel String
  embedding      Unsupported("vector(1536)")?
  createdAt      DateTime                     @default(now())

  doc AiKnowledgeDoc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@unique([docId, ordinal])
}
