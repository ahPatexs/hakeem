  messages      DoctorAiMessage[]

  @@index([doctorUserId, updatedAt])
}

model DoctorAiMessage {
  id             String               @id @default(cuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime             @default(now())
  conversation   DoctorAiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model DoctorPatientPanel {
  id            String   @id @default(cuid())
  doctorId      String
  patientUserId String
  createdAt     DateTime @default(now())
  patient       User     @relation("PanelPatient", fields: [patientUserId], references: [id], onDelete: Cascade)

  @@unique([doctorId, patientUserId])
}

model DoctorProfileExtras {
  userId            String   @id
  bio               String?
  languages         String[] @default([])
  consultationPrefs Json?
  timezone          String?
  updatedAt         DateTime @updatedAt
